[Unit]
Description=Linux Update Tool System Daemon
Documentation=https://github.com/DomiLuebben/linux-update-tool
After=network.target dbus.service

[Service]
Type=dbus
BusName=org.linuxupdatetool.Daemon1
ExecStart=/usr/libexec/lutd
Restart=on-failure
# Keine Dateisystem- oder Socket-Sandbox: lutd startet DNF5/APT/pacman samt
# RPM-/dpkg-Scriptlets, die überall schreiben dürfen müssen (/run/dnf,
# /root, /efi, Netlink für Firewall-/Netzwerk-Scriptlets). Mit
# ProtectSystem=strict lehnt DNF5 den Commit als "requires superuser
# privileges" ab, obwohl lutd als root läuft.
PrivateTmp=yes
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
