<?xml version="1.0" encoding="utf-8"?>
<components origin="archlinux" version="0.16">
  <component type="desktop-application">
    <id>org.kde.kwrite</id>
    <pkgname>kwrite</pkgname>
    <name>KWrite</name>
    <name xml:lang="de">KWrite Texteditor</name>
    <summary>Text Editor</summary>
    <summary xml:lang="de">Ein schlanker Texteditor von KDE</summary>
    <description>
      <p>KWrite is a text editor by KDE.</p>
      <p xml:lang="de">KWrite ist ein einfacher Texteditor von KDE.</p>
    </description>
    <developer id="org.kde">
      <name>KDE Community</name>
    </developer>
    <project_license>GPL-2.0-or-later</project_license>
    <url type="homepage">https://apps.kde.org/kwrite/</url>
    <url type="bugtracker">https://bugs.kde.org/</url>
    <icon type="stock">accessories-text-editor</icon>
    <categories>
      <category>Utility</category>
      <category>TextEditor</category>
    </categories>
    <keywords>
      <keyword>text</keyword>
      <keyword>editor</keyword>
      <keyword xml:lang="de">Schreiben</keyword>
    </keywords>
    <launchable type="desktop-id">org.kde.kwrite.desktop</launchable>
    <screenshots>
      <screenshot type="default">
        <caption>Main Window</caption>
        <image type="source" width="1280" height="720">https://example.org/kwrite.png</image>
      </screenshot>
    </screenshots>
  </component>

  <component type="desktop-application">
    <id>org.gimp.GIMP</id>
    <pkgname>gimp</pkgname>
    <name>GIMP</name>
    <summary>GNU Image Manipulation Program</summary>
    <summary xml:lang="de">GNU-Bildbearbeitungsprogramm</summary>
    <description>
      <p>GIMP is an advanced image editor.</p>
      <p xml:lang="de">GIMP ist ein fortschrittlicher Bildeditor.</p>
    </description>
    <developer id="org.gimp">
      <name>The GIMP Team</name>
    </developer>
    <project_license>GPL-3.0-or-later</project_license>
    <url type="homepage">https://www.gimp.org/</url>
    <icon type="stock">gimp</icon>
    <categories>
      <category>Graphics</category>
      <category>2DGraphics</category>
    </categories>
    <launchable type="desktop-id">gimp.desktop</launchable>
    <screenshots>
      <screenshot type="default">
        <image type="source" width="1920" height="1080">https://example.org/gimp.png</image>
      </screenshot>
    </screenshots>
  </component>

